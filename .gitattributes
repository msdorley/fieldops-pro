# ============================================================================
# FieldOps Pro -- .gitattributes
# ----------------------------------------------------------------------------
# Enforces consistent line endings across contributors regardless of OS or Git
# config.
#
# NOTE: git attributes control line endings only. They do NOT add or remove a
# byte-order mark. The BOM policy is enforced by the A1 and A2 audits and is
# documented in DOCS/EXTENDING.md; the rules are restated below so this file
# cannot drift away from them silently again.
# ============================================================================

# Default: Git decides. Most files behave normally.
* text=auto

# ---- PowerShell -------------------------------------------------------------
# CRLF is the Windows-shell convention.
#
# Encoding (audit A1/A2, not enforced by this file): ASCII only, NO BOM.
# Deployed scripts carry no accented characters at all -- French text lives in
# CONFIG/lang/*.json, never in source. That is what makes the ASCII rule
# enforceable.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# ---- JSON / locale data -----------------------------------------------------
# LF endings.
#
# Encoding (audit A1/A2, not enforced by this file): CONFIG/lang/*.json is
# UTF-8 WITH BOM and carries literal accented characters. PowerShell 5.1's
# ConvertFrom-Json needs the BOM to read them correctly.
*.json  text eol=lf

# ---- Markdown / docs --------------------------------------------------------
*.md    text eol=lf
*.txt   text eol=lf

# ---- Shell / CI -------------------------------------------------------------
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# ---- Windows-specific config -----------------------------------------------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.reg   text eol=crlf

# ---- Binaries (do not touch) ------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.exe   binary
*.dll   binary
*.msi   binary
*.iso   binary

# ---- GitHub linguist hints --------------------------------------------------
# Prevent locale JSON files from dominating language stats on GitHub.
CONFIG/lang/*.json linguist-language=JSON linguist-detectable=false
DOCS/**            linguist-documentation=true
