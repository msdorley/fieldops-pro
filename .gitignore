# ============================================================================
# FieldOps Pro — .gitignore
# ----------------------------------------------------------------------------
# Anything matching these patterns will NOT be committed to the public repo.
# Audit with: git status --ignored
# ============================================================================

# ---- Secrets & operator identity -------------------------------------------
# The real technician config holds operator identity. Only the template ships.
CONFIG/technician.json
CONFIG/secrets.json
CONFIG/*.local.json
*.env
.env
.env.*

# ---- Runtime output --------------------------------------------------------
# Generated by the toolkit at runtime. Never source-controlled.
LOGS/
REPORTS/
SNAPSHOTS/
SCRIPTS/LOGS/
SCRIPTS/REPORTS/
**/*.log
**/*.log.*
**/launch_errors.log
**/Recovery.txt
**/errors.txt
**/dmesg_*

# Compliance snapshots and integrity sidecars
**/*.json.gz
**/*.sha256

# Backup files left by editors and the toolkit's own auto-save
**/*.bak
**/*.bak.*
**/*~
**/*.orig
**/FieldOps-Tools-BACKUP.txt

# ---- Third-party binaries (NOT redistributed in repo) ----------------------
# These are fetched by the operator from upstream. See DOCS/Tools.md.
TOOLS/
DRIVERS/
ISO/
etc/
*.iso
*.exe
*.dll
*.msi
*.zip
# Allow Get-PortableTools.ps1 helper if/when it lives under tools/
!tools/*.ps1
!tools/**/*.ps1

# ---- OneDrive sync conflict files ------------------------------------------
**/*-conflicts/
**/* (1).*
**/* (2).*

# ---- OS metadata -----------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ---- Editor / IDE noise ----------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- PowerShell module test artefacts --------------------------------------
**/PSScriptAnalyzerSettings.psd1.bak
TestResults/
coverage/

# ---- Debug & scratch -------------------------------------------------------
debug.log
debug2.log
debug3.log
scratch/
tmp/
TEMP/
# === Phase drops never enter the repo (use C:\Dev\fieldops-staging) ===
phase-*-drop/
phase-*-drop
*-drop/
_archive/
*.phase[0-9]*-*.bak
# === Local config snapshots and customer drafts ===
reports-draft/
*.config.local.json
FieldOps.config.json

# ---- Pester offline bundle (D2) -- intentionally tracked for air-gap USB ---
!TOOLS/
!TOOLS/PowerShellModules/
!TOOLS/PowerShellModules/**
!TOOLS/PowerShellModules/Populate-PesterBundle.ps1
!TOOLS/PowerShellModules/README.md
!TOOLS/PowerShellModules/Pester/
!TOOLS/PowerShellModules/Pester/5.7.1/
!TOOLS/PowerShellModules/Pester/5.7.1/**

# ---- Pester offline bundle (D2) -- intentionally tracked for air-gap USB ---
!TOOLS/
!TOOLS/PowerShellModules/
!TOOLS/PowerShellModules/**
!TOOLS/PowerShellModules/Populate-PesterBundle.ps1
!TOOLS/PowerShellModules/README.md
!TOOLS/PowerShellModules/Pester/
!TOOLS/PowerShellModules/Pester/5.7.1/
!TOOLS/PowerShellModules/Pester/5.7.1/**
